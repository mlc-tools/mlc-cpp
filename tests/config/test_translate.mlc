    function void test_translate_dynamic_pointer_cast_intrusive()
    {
        auto request = new RequestBar();

        auto request_base = request;
        this->assertTrue(request_base != nullptr);
        this->assertEqual(request_base->get_type(), RequestBar::TYPE, "");

        auto request_bar = dynamic_pointer_cast_intrusive<RequestBar>(request_base);
        this->assertTrue(request_bar != nullptr);
        this->assertEqual(request_bar->get_type(), RequestBar::TYPE, "");

        auto request_bar2 = dynamic_pointer_cast_intrusive<RequestBar, Request>(request_base);
        this->assertTrue(request_bar2 != nullptr);
        this->assertEqual(request_bar2->get_type(), RequestBar::TYPE, "");
    }
    function void test_min_max()
    {
        this->assertEqual(std::min(1, 2), 1);
        this->assertEqual(std::max(1, 2), 2);
        this->assertEqual(std::min<int>(1, 2), 1);
        this->assertEqual(std::max<int>(1, 2), 2);
        this->assertEqual(std::min<float>(1, 2), 1.f);
        this->assertEqual(std::max<float>(1, 2), 2.f);
    }

    function void test_swap()
    {
        vector_push(this->test_vector_swap1, 1);
        vector_push(this->test_vector_swap1, 2);
        vector_push(this->test_vector_swap2, 3);
        mg_swap(this->test_vector_swap1, this->test_vector_swap2);
        this->assertEqual(vector_size(this->test_vector_swap1), 1);
        this->assertEqual(vector_size(this->test_vector_swap2), 2);
        this->assertEqual(this->test_vector_swap1[0], 3);
        this->assertEqual(this->test_vector_swap2[0], 1);
        this->assertEqual(this->test_vector_swap2[1], 2);

        int a = 1;
        int b = 2;
        mg_swap(a, b);
        this->assertEqual(a, 2);
        this->assertEqual(b, 1);

        std::string sa = "1";
        std::string sb = "2";
        mg_swap(sa, sb);
        this->assertTrue(sa == "2");
        this->assertTrue(sb == "1");
    }

    function void test_split()
    {
        auto string = "123x4568";
        auto values = split(string, 'x');
        this->assertEqual(vector_size(values), 2);
        this->assertTrue(values[0] == "123");
        this->assertTrue(values[1] == "4568");
        this->assertTrue(join(values, 'x') == string);

        string = "123x";
        values = split(string, 'x');
        this->assertEqual(vector_size(values), 2);
        this->assertTrue(values[0] == "123");
        this->assertTrue(values[1] == "");
        this->assertTrue(join(values, 'x') == string);

        string = "x123";
        values = split(string, 'x');
        this->assertEqual(vector_size(values), 2);
        this->assertTrue(values[0] == "");
        this->assertTrue(values[1] == "123");
        this->assertTrue(join(values, 'x') == string);

        string = "x";
        values = split(string, 'x');
        this->assertEqual(vector_size(values), 2);
        this->assertTrue(values[0] == "");
        this->assertTrue(values[1] == "");
        this->assertTrue(join(values, 'x') == string);

        string = "";
        values = split(string, 'x');
        this->assertEqual(vector_size(values), 1);
        this->assertTrue(join(values, 'x') == string);

        string = "1,,2,,3";
        values = split(string, ',');
        this->assertEqual(vector_size(values), 5);
        this->assertTrue(values[0] == "1");
        this->assertTrue(values[1] == "");
        this->assertTrue(values[2] == "2");
        this->assertTrue(values[3] == "");
        this->assertTrue(values[4] == "3");
        this->assertTrue(join(values, ',') == string);
    }

    function void test_conditional_arrow_and_ternary():cpp:py
    {
        auto obj = new Translates();
        // Should translate to: if(obj) obj->dummy_function();
        obj?->dummy_function();

        // Ensure multiple uses compile and do nothing harmful when nullptr
        obj = nullptr;
        obj?->dummy_function();

        //
//        auto result = Translates::build_object()?->dummy_function();
//        this->assertEqual(result, 5);

        //
        int value5 = 5 + Translates::build_object()?->dummy_function();
        this->assertEqual(value5, 10);

        //
        obj = new Translates();
        obj->value = 1;
        obj->value = obj->get_null<int>(obj->value)?->get_with_string("attack");
        this->assertEqual(obj->value, 1);

        int value1 = 0;
        value1 += obj->get_not_null<int>(obj->value)?->get_with_string("attack");
        this->assertEqual(value1, 10);


        // Ternary operator must remain intact
        int a = 1;
        int b = 2;
        int c = (a > b) ? a : b;
        this->assertEqual(c, 2);
    }

    fn void test_while_simple()
    {
        int a = 0;
        while(false)
        {
            a = 1;
        }
    }
    fn void test_safe_at_vector():cpp
    {
        std::vector<int> values;

        auto& result1, value1 = values.at(0);

        this->assertFalse(result1);
        this->assertEqual(value1, 0);

        vector_push(values, 1);
        vector_push(values, 2);

        auto result2, value2 = values.at(0);
        this->assertTrue(result2, "1");
        this->assertEqual(value2, 1, "2");
        value2 = 5;
        this->assertEqual(value2, 5, "3");
        this->assertEqual(values.at(0), 1, "4");

        auto& result3, value3 = values.at(1);
        this->assertTrue(result3, "5");
        this->assertEqual(value3, 2, "6");
        value3 = 5;
        this->assertEqual(value3, 5, "7");
        this->assertEqual(values.at(1), 5, "8");

        auto result4, value4 = values.at(2);
        this->assertFalse(result4, "9");
        this->assertEqual(value4, 0, "10");
        
    }
    fn void test_safe_at_map():cpp
    {
        std::map<int, std::string> values;
        {
            auto& result, value = values.at(0);

            this->assertFalse(result);
            this->assertEqual(value, "");
        }

        values[1] = "1";
        values[2] = "2";

        {
            auto result, value = values.at(1);
            this->assertTrue(result);
            this->assertEqual(value, "1");
            value = "5";
            this->assertEqual(value, "5");
            this->assertEqual(values.at(1), "1");
        }
        {
            auto& result, value = values.at(2);
            this->assertTrue(result);
            this->assertEqual(value, "2");
            value = "5";
            this->assertEqual(value, "5");
            this->assertEqual(values.at(2), "5");
        }
        {
            auto result, value = values.at(3);
            this->assertFalse(result);
            this->assertEqual(value, "");
        }
    }
    fn void test_model():cpp
    {
        auto model = new ModelUnits();
        model->initialize("1", "11");
        model->initialize("2", "22");
        this->assertEqual(map_size(model->models), 2);
        this->assertEqual(model->models.at("1")->value, "11");
        this->assertEqual(model->models.at("2")->value, "22");

        model->initialize("1", "12");
        model->initialize("2", "23");
        this->assertEqual(map_size(model->models), 2);
        this->assertEqual(model->models.at("1")->value, "12");
        this->assertEqual(model->models.at("2")->value, "23");
    }
    fn void test_model2():cpp
    {
        auto model = new ModelUnits();
        model->initialize2("1", "11");
        model->initialize2("2", "22");
        this->assertEqual(map_size(model->models), 2);
        this->assertEqual(model->models.at("1")->value, "11");
        this->assertEqual(model->models.at("2")->value, "22");

        model->initialize2("1", "12");
        model->initialize2("2", "23");
        this->assertEqual(map_size(model->models), 2);
        this->assertEqual(model->models.at("1")->value, "12");
        this->assertEqual(model->models.at("2")->value, "23");
    }
}
class model/ModelUnits
{
    class ModelIn
    {
        string value
    }
    map<string, ModelIn*> models

    fn void initialize(string key, string value)
    {
        if(!in_map(key, this->models))
        {
            this->models[key] = new ModelIn();
            this->models[key]->value = key;
        }
        auto model = this->models.at(key);
        model->value = value;
    }
    fn void initialize2(string key, string value)
    {
        auto& result, model = this->models.at(key);
        if(!result)
        {
            this->models[key] = model = new ModelIn();
        }
        model->value = value;
    }
}

class NullishOperator
{
    Point* point_a
    Point* point_b

    function void dummy_function()
    {

    }
}

class TestNullishOperator<ITestNullishOperator>
{
    function void test_dummy_function()
    {
    }

    function void test_nullish_coalescing_operator()
    {
        auto test = new NullishOperator();
        test->point_a = nullptr;
        test->point_b = new Point();
        test->point_b->x = 10;
        test->point_b->y = 20;

        Point* point_c = test->point_a ?? test->point_b;

        this->assertNotNull(point_c);
        this->assertEqual(point_c->x, 10);
        this->assertEqual(point_c->y, 20);
    }

