class Translates
{
    int value = 0

    function int dummy_function()
    {
        return 5;
    }
    function void new_function()
    {
    }

    function<T> Translates* get_null(T value)
    {
        return nullptr;
    }
    function<T> Translates* get_not_null(T value)
    {
        return this;
    }

    fn int get_with_string(string value)
    {
        return 10;
    }


    function Translates* build_object():static
    {
        return new Translates();
    }

}
class Point
{
    int x
    int y

    function Point create(int x, int y):static
    {
        Point point;
        point.x = x;
        point.y = y;
        return point;
    }
}
class TestTranslates<ITestTranslates>
{
    class Model
    {
        DataUnit:link data
    }
    map<string, Model*> test_map_models
    vector<int> test_vector_lambda
