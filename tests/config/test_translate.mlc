    function void test_list()
    {
        std::vector<int> l0;
        std::vector<int*> l1;
        std::vector<std::string> l2;
        std::vector<intrusive_ptr<Translates>> l3;

        vector_push(l0, 1);
        vector_push(l1, nullptr);
        vector_push(l2, "");
        vector_push(l3, new Translates());

        this->assertTrue(in_vector(1, l0));
        this->assertTrue(in_vector(nullptr, l1));
        this->assertTrue(in_vector("", l2));
        this->assertTrue(vector_size(l3) == 1);
    }
    function void test_vector_index()
    {
        std::vector<int> l;
        vector_push(l, 1);
        vector_push(l, 2);
        vector_push(l, 5);
        vector_push(l, 4);
        vector_push(l, 3);

        this->assertTrue(vector_index(l, 1) == 0);
        this->assertTrue(vector_index(l, 2) == 1);
        this->assertTrue(vector_index(l, 5) == 2);
        this->assertTrue(vector_index(l, 4) == 3);
        this->assertTrue(vector_index(l, 3) == 4);
        this->assertTrue(vector_index(l, 0) == -1);
        this->assertIn(1, l, "1 result list");
    }

    function void test_map()
    {
        std::map<int, int> m0;
        std::map<int, int*> m1;
        std::map<std::string, std::string> m2;
        std::map<std::string, Translates*> m3;

        m0[0] = 1;
        m1[0] = nullptr;
        m2[""] = "";
        m3[""] = new Translates();

        this->assertTrue(in_map(0, m0));
        this->assertTrue(m0[0] == 1);

        this->assertTrue(in_map(0, m1));
        this->assertTrue(m1[0] == nullptr);

        this->assertTrue(in_map("", m2));
        this->assertTrue(m2[""] == "");

        this->assertTrue(map_size(m3) == 1);
    }
