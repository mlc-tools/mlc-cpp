        vector_push(this->test_vector_lambda, 4);
        vector_do_if(this->test_vector_lambda, (value :> value == 3 :> vector_remove(this->test_vector_lambda, 3)));

        this->assertEqual(vector_size(this->test_vector_lambda), 1);
        this->assertEqual(this->test_vector_lambda[0], 4);
    }
