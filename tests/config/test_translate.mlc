    function void test_vector_insert()
    {
        std::vector<int> vector;

        vector_insert(vector, 0, 1);
        this->assertTrue(vector_size(vector) == 1);
        this->assertTrue(vector[0] == 1);

        vector_insert(vector, 0, 2);
        this->assertTrue(vector_size(vector) == 2);
        this->assertTrue(vector[0] == 2);
        this->assertTrue(vector[1] == 1);

        vector_insert(vector, 1, 3);
        this->assertTrue(vector_size(vector) == 3);
        this->assertTrue(vector[0] == 2);
        this->assertTrue(vector[1] == 3);
        this->assertTrue(vector[2] == 1);
    }

    function void test_vector_erase()
    {
        std::vector<int> vector;
        vector_push(vector, 1);
        vector_push(vector, 2);
        vector_push(vector, 3);
        vector_push(vector, 4);

        vector_erase(vector, 0);
        this->assertTrue(vector_size(vector) == 3);
        this->assertTrue(vector[0] == 2);
        this->assertTrue(vector[1] == 3);
        this->assertTrue(vector[2] == 4);

        vector_erase(vector, 1);
        this->assertTrue(vector_size(vector) == 2);
        this->assertTrue(vector[0] == 2);
        this->assertTrue(vector[1] == 4);

        vector_erase(vector, 1);
        this->assertTrue(vector_size(vector) == 1);
        this->assertTrue(vector[0] == 2);
    }

    function void test_vector_truncate()
    {
        std::vector<int> vector;
        vector_push(vector, 1);
        vector_push(vector, 2);
        vector_push(vector, 3);
        vector_push(vector, 4);

        vector_truncate(vector, 3);
        this->assertTrue(vector_size(vector) == 3);
        this->assertTrue(vector[0] == 1);
        this->assertTrue(vector[1] == 2);
        this->assertTrue(vector[2] == 3);

        vector_truncate(vector, 1);
        this->assertTrue(vector_size(vector) == 1);
        this->assertTrue(vector[0] == 1);

        vector_truncate(vector, 0);
        this->assertTrue(vector_size(vector) == 0);
    }

