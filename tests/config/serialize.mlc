class SerializeTest
{
    vector<DataUnit*> vector_of_data
}

class TestSerializeTest<ITestSerializeTest>
{
    fn void test_serialize_python()
    {
        auto obj = new SerializeTest();
        auto data = new DataUnit();
        data->name = "test_unit";
        vector_push(obj->vector_of_data, data);
        auto obj2 = clone_object<SerializeTest>(obj);
        this->assertNotNull(obj2);
        this->assertEqual(vector_size(obj2->vector_of_data), 1);
        this->assertNotNull(obj2->vector_of_data.at(0));
        this->assertEqual(obj2->vector_of_data.at(0)->name, data->name);
    }

}
